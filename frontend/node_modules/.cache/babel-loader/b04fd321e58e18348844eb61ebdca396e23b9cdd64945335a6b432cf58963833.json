{"ast":null,"code":"import { getLeaveTypes, submitApplication } from '@/api/leave';\nimport { getUser } from '@/utils/auth';\nexport default {\n  name: 'ApplyLeave',\n  data() {\n    return {\n      leaveTypes: [],\n      form: {\n        leaveTypeId: '',\n        startTime: '',\n        endTime: '',\n        reason: '',\n        applicantId: ''\n      },\n      message: '',\n      isError: false\n    };\n  },\n  created() {\n    const user = getUser();\n    if (user) {\n      this.form.applicantId = user.id;\n    } else {\n      this.$router.push('/login');\n    }\n    this.fetchLeaveTypes();\n  },\n  methods: {\n    async fetchLeaveTypes() {\n      try {\n        // Response might be the list directly or wrapped in data object depending on axios setup\n        const response = await getLeaveTypes();\n        // Assuming response is the list based on controller returning ResponseEntity.ok(list)\n        // and axios interceptor returning response.data\n        this.leaveTypes = response || [];\n      } catch (error) {\n        console.error('Failed to load leave types', error);\n      }\n    },\n    async handleSubmit() {\n      this.message = '';\n      this.isError = false;\n\n      // Basic validation\n      if (new Date(this.form.startTime) >= new Date(this.form.endTime)) {\n        this.message = '结束时间必须晚于开始时间';\n        this.isError = true;\n        return;\n      }\n      try {\n        await submitApplication(this.form);\n        this.message = '申请提交成功！';\n        // Reset form\n        this.form.reason = '';\n        this.form.startTime = '';\n        this.form.endTime = '';\n      } catch (error) {\n        this.message = '提交失败: ' + (error.response?.data || error.message);\n        this.isError = true;\n      }\n    }\n  }\n};","map":{"version":3,"names":["getLeaveTypes","submitApplication","getUser","name","data","leaveTypes","form","leaveTypeId","startTime","endTime","reason","applicantId","message","isError","created","user","id","$router","push","fetchLeaveTypes","methods","response","error","console","handleSubmit","Date"],"sources":["C:\\ThesisProject\\frontend\\src\\views\\student\\ApplyLeave.vue"],"sourcesContent":["<template>\n  <div class=\"apply-leave-container\">\n    <h2>申请请假</h2>\n    <form @submit.prevent=\"handleSubmit\">\n      <div class=\"form-group\">\n        <label>请假类型:</label>\n        <select v-model=\"form.leaveTypeId\" required>\n          <option v-for=\"type in leaveTypes\" :key=\"type.id\" :value=\"type.id\">\n            {{ type.name }}\n          </option>\n        </select>\n      </div>\n\n      <div class=\"form-group\">\n        <label>开始时间:</label>\n        <input type=\"datetime-local\" v-model=\"form.startTime\" required />\n      </div>\n\n      <div class=\"form-group\">\n        <label>结束时间:</label>\n        <input type=\"datetime-local\" v-model=\"form.endTime\" required />\n      </div>\n\n      <div class=\"form-group\">\n        <label>请假事由:</label>\n        <textarea v-model=\"form.reason\" required></textarea>\n      </div>\n\n      <button type=\"submit\">提交申请</button>\n    </form>\n    \n    <div v-if=\"message\" :class=\"['message', isError ? 'error' : 'success']\">\n      {{ message }}\n    </div>\n  </div>\n</template>\n\n<script>\nimport { getLeaveTypes, submitApplication } from '@/api/leave'\nimport { getUser } from '@/utils/auth'\n\nexport default {\n  name: 'ApplyLeave',\n  data() {\n    return {\n      leaveTypes: [],\n      form: {\n        leaveTypeId: '',\n        startTime: '',\n        endTime: '',\n        reason: '',\n        applicantId: '' \n      },\n      message: '',\n      isError: false\n    }\n  },\n  created() {\n    const user = getUser()\n    if (user) {\n      this.form.applicantId = user.id\n    } else {\n      this.$router.push('/login')\n    }\n    this.fetchLeaveTypes()\n  },\n\n  methods: {\n    async fetchLeaveTypes() {\n      try {\n        // Response might be the list directly or wrapped in data object depending on axios setup\n        const response = await getLeaveTypes()\n        // Assuming response is the list based on controller returning ResponseEntity.ok(list)\n        // and axios interceptor returning response.data\n        this.leaveTypes = response || []\n      } catch (error) {\n        console.error('Failed to load leave types', error)\n      }\n    },\n    async handleSubmit() {\n      this.message = ''\n      this.isError = false\n      \n      // Basic validation\n      if (new Date(this.form.startTime) >= new Date(this.form.endTime)) {\n        this.message = '结束时间必须晚于开始时间'\n        this.isError = true\n        return\n      }\n\n      try {\n        await submitApplication(this.form)\n        this.message = '申请提交成功！'\n        // Reset form\n        this.form.reason = ''\n        this.form.startTime = ''\n        this.form.endTime = ''\n      } catch (error) {\n        this.message = '提交失败: ' + (error.response?.data || error.message)\n        this.isError = true\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.apply-leave-container {\n  max-width: 500px;\n  margin: 20px auto;\n  padding: 20px;\n  border: 1px solid #ccc;\n  border-radius: 8px;\n}\n.form-group {\n  margin-bottom: 15px;\n}\n.form-group label {\n  display: block;\n  margin-bottom: 5px;\n}\n.form-group input,\n.form-group select,\n.form-group textarea {\n  width: 100%;\n  padding: 8px;\n  box-sizing: border-box;\n}\nbutton {\n  width: 100%;\n  padding: 10px;\n  background-color: #4CAF50;\n  color: white;\n  border: none;\n  cursor: pointer;\n}\nbutton:hover {\n  background-color: #45a049;\n}\n.message {\n  margin-top: 15px;\n  padding: 10px;\n  text-align: center;\n}\n.success {\n  color: green;\n  background-color: #e8f5e9;\n}\n.error {\n  color: red;\n  background-color: #ffebee;\n}\n</style>\n"],"mappings":"AAsCA,SAASA,aAAa,EAAEC,iBAAgB,QAAS,aAAY;AAC7D,SAASC,OAAM,QAAS,cAAa;AAErC,eAAe;EACbC,IAAI,EAAE,YAAY;EAClBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,UAAU,EAAE,EAAE;MACdC,IAAI,EAAE;QACJC,WAAW,EAAE,EAAE;QACfC,SAAS