{"ast":null,"code":"import { register } from '@/api/auth';\nimport { ElMessage } from 'element-plus';\nimport { User, Lock, Postcard, Message, Iphone, School } from '@element-plus/icons-vue';\nexport default {\n  name: 'Register',\n  components: {\n    // Icons\n  },\n  data() {\n    return {\n      form: {\n        username: '',\n        realName: '',\n        password: '',\n        role: 'STUDENT',\n        departmentId: 1,\n        className: '',\n        email: '',\n        phone: ''\n      },\n      loading: false\n    };\n  },\n  methods: {\n    async handleRegister() {\n      if (!this.form.username || !this.form.password || !this.form.realName) {\n        ElMessage.warning('请填写必填项');\n        return;\n      }\n      this.loading = true;\n      try {\n        await register(this.form);\n        ElMessage.success('注册成功，请登录');\n        this.$router.push('/login');\n      } catch (err) {\n        ElMessage.error(err.response?.data || '注册失败');\n      } finally {\n        this.loading = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["register","ElMessage","User","Lock","Postcard","Message","Iphone","School","name","components","data","form","username","realName","password","role","departmentId","className","email","phone","loading","methods","handleRegister","warning","success","$router","push","err","error","response"],"sources":["C:\\ThesisProject\\frontend\\src\\views\\Register.vue"],"sourcesContent":["<template>\n  <div class=\"register-container\">\n    <el-card class=\"register-card\">\n      <template #header>\n        <div class=\"card-header\">\n          <h2>用户注册</h2>\n        </div>\n      </template>\n\n      <el-form :model=\"form\" @submit.prevent=\"handleRegister\" label-width=\"100px\" status-icon>\n        \n        <el-form-item label=\"用户名\" required>\n          <el-input v-model=\"form.username\" placeholder=\"请输入学号或工号\" prefix-icon=\"User\" />\n        </el-form-item>\n\n        <el-form-item label=\"真实姓名\" required>\n          <el-input v-model=\"form.realName\" placeholder=\"请输入真实姓名\" prefix-icon=\"Postcard\" />\n        </el-form-item>\n\n        <el-form-item label=\"密码\" required>\n          <el-input \n            v-model=\"form.password\" \n            type=\"password\" \n            placeholder=\"请输入密码\" \n            prefix-icon=\"Lock\" \n            show-password \n          />\n        </el-form-item>\n\n        <el-form-item label=\"邮箱\">\n          <el-input v-model=\"form.email\" placeholder=\"请输入邮箱 (选填)\" prefix-icon=\"Message\" />\n        </el-form-item>\n\n        <el-form-item label=\"手机号\">\n          <el-input v-model=\"form.phone\" placeholder=\"请输入手机号 (选填)\" prefix-icon=\"Iphone\" />\n        </el-form-item>\n\n        <el-form-item label=\"角色\" required>\n          <el-radio-group v-model=\"form.role\">\n            <el-radio label=\"STUDENT\">学生</el-radio>\n            <el-radio label=\"TEACHER\">教师</el-radio>\n            <el-radio label=\"ADMIN\">管理员</el-radio>\n          </el-radio-group>\n        </el-form-item>\n\n        <el-form-item \n          :label=\"form.role === 'STUDENT' ? '所在班级' : '管理班级'\" \n          required \n          v-if=\"form.role !== 'ADMIN'\"\n        >\n          <el-input \n            v-model=\"form.className\" \n            :placeholder=\"form.role === 'STUDENT' ? '例如: 2023级1班' : '例如: 2023级1班, 2班'\" \n            prefix-icon=\"School\"\n          />\n        </el-form-item>\n\n        <el-form-item label=\"院系ID\">\n           <el-input-number v-model=\"form.departmentId\" :min=\"1\" />\n           <span class=\"tip-text\">(默认为1-计算机系)</span>\n        </el-form-item>\n\n        <el-form-item>\n          <el-button type=\"success\" :loading=\"loading\" @click=\"handleRegister\" class=\"w-100\">\n            注册\n          </el-button>\n        </el-form-item>\n\n        <div class=\"links\">\n          <router-link to=\"/login\">\n            <el-link type=\"primary\">已有账号？去登录</el-link>\n          </router-link>\n        </div>\n      </el-form>\n    </el-card>\n  </div>\n</template>\n\n<script>\nimport { register } from '@/api/auth'\nimport { ElMessage } from 'element-plus'\nimport { User, Lock, Postcard, Message, Iphone, School } from '@element-plus/icons-vue'\n\nexport default {\n  name: 'Register',\n  components: {\n    // Icons\n  },\n  data() {\n    return {\n      form: {\n        username: '',\n        realName: '',\n        password: '',\n        role: 'STUDENT',\n        departmentId: 1,\n        className: '',\n        email: '',\n        phone: ''\n      },\n      loading: false\n    }\n  },\n  methods: {\n    async handleRegister() {\n      if(!this.form.username || !this.form.password || !this.form.realName) {\n         ElMessage.warning('请填写必填项')\n         return\n      }\n\n      this.loading = true\n      try {\n        await register(this.form)\n        ElMessage.success('注册成功，请登录')\n        this.$router.push('/login')\n      } catch (err) {\n        ElMessage.error(err.response?.data || '注册失败')\n      } finally {\n        this.loading = false\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.register-container {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  min-height: 100vh;\n  padding: 20px 0;\n  background-color: #f0f2f5;\n  background-image: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);\n}\n.register-card {\n  width: 500px;\n}\n.card-header {\n  text-align: center;\n}\n.card-header h2 {\n  margin: 0;\n  color: #303133;\n}\n.w-100 {\n  width: 100%;\n}\n.links {\n  text-align: right;\n  margin-top: 10px;\n}\n.tip-text {\n  margin-left: 10px;\n  font-size: 12px;\n  color: #909399;\n}\n</style>\n"],"mappings":"AA+EA,SAASA,QAAO,QAAS,YAAW;AACpC,SAASC,SAAQ,QAAS,cAAa;AACvC,SAASC,IAAI,EAAEC,IAAI,EAAEC,QAAQ,EAAEC,OAAO,EAAEC,MAAM,EAAEC,MAAK,QAAS,yBAAwB;AAEtF,eAAe;EACbC,IAAI,EAAE,UAAU;EAChBC,UAAU,EAAE;IACV;EAAA,CACD;EACDC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE;QACJC,QAAQ,EAAE,EAAE;QACZC,QAAQ,EAAE,EAAE;QACZC,QAAQ,EAAE,EAAE;QACZC,IAAI,EAAE,SAAS;QACfC,YAAY,EAAE,CAAC;QACfC,SAAS,EAAE,EAAE;QACbC,KAAK,EAAE,EAAE;QACTC,KAAK,EAAE;MACT,CAAC;MACDC,OAAO,EAAE;IACX;EACF,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,cAAcA,CAAA,EAAG;MACrB,IAAG,CAAC,IAAI,CAACX,IAAI,CAACC,QAAO,IAAK,CAAC,IAAI,CAACD,IAAI,CAACG,QAAO,IAAK,CAAC,IAAI,CAACH,IAAI,CAACE,QAAQ,EAAE;QACnEZ,SAAS,CAACsB,OAAO,CAAC,QAAQ;QAC1B;MACH;MAEA,IAAI,CAACH,OAAM,GAAI,IAAG;MAClB,IAAI;QACF,MAAMpB,QAAQ,CAAC,IAAI,CAACW,IAAI;QACxBV,SAAS,CAACuB,OAAO,CAAC,UAAU;QAC5B,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC,QAAQ;MAC5B,EAAE,OAAOC,GAAG,EAAE;QACZ1B,SAAS,CAAC2B,KAAK,CAACD,GAAG,CAACE,QAAQ,EAAEnB,IAAG,IAAK,MAAM;MAC9C,UAAU;QACR,IAAI,CAACU,OAAM,GAAI,KAAI;MACrB;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}