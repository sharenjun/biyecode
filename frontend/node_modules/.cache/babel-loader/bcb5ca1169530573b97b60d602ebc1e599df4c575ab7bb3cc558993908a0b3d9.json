{"ast":null,"code":"import { getLeaveTypes, submitApplication } from '@/api/leave';\nimport { getUser } from '@/utils/auth';\nimport { ElMessage } from 'element-plus';\nimport { EditPen, Phone, CircleCheck } from '@element-plus/icons-vue';\nexport default {\n  name: 'ApplyLeave',\n  components: {\n    EditPen,\n    Phone,\n    CircleCheck\n  },\n  data() {\n    return {\n      leaveTypes: [],\n      userInfo: {\n        username: '',\n        realName: '',\n        className: ''\n      },\n      form: {\n        applicantId: '',\n        leaveTypeId: '',\n        startTime: '',\n        endTime: '',\n        reason: '',\n        contactPhone: '',\n        attachmentUrl: ''\n      },\n      isSubmitting: false,\n      backendUrl: 'http://localhost:8080'\n    };\n  },\n  created() {\n    const user = getUser();\n    if (user) {\n      this.form.applicantId = user.id;\n      this.userInfo.username = user.username;\n      this.userInfo.realName = user.realName;\n      this.userInfo.className = user.className || '未知班级';\n      if (user.phone) this.form.contactPhone = user.phone;\n    } else {\n      this.$router.push('/login');\n    }\n    this.fetchLeaveTypes();\n  },\n  methods: {\n    async fetchLeaveTypes() {\n      try {\n        const response = await getLeaveTypes();\n        this.leaveTypes = response || [];\n      } catch (error) {\n        console.error('Failed to load leave types', error);\n      }\n    },\n    beforeUpload(file) {\n      const isLt5M = file.size / 1024 / 1024 < 5;\n      if (!isLt5M) {\n        ElMessage.error('上传文件大小不能超过 5MB!');\n      }\n      return isLt5M;\n    },\n    handleUploadSuccess(res) {\n      // res is the file path returned by backend string\n      this.form.attachmentUrl = res;\n      ElMessage.success('上传成功');\n    },\n    handleUploadError() {\n      ElMessage.error('上传失败，请重试');\n    },\n    async handleSubmit() {\n      if (!this.form.leaveTypeId || !this.form.startTime || !this.form.endTime || !this.form.reason || !this.form.contactPhone) {\n        ElMessage.warning('请填写所有必填项');\n        return;\n      }\n      if (new Date(this.form.startTime) >= new Date(this.form.endTime)) {\n        ElMessage.warning('结束时间必须晚于开始时间');\n        return;\n      }\n      this.isSubmitting = true;\n      try {\n        await submitApplication(this.form);\n        ElMessage.success('申请提交成功！');\n        // Reset fields\n        this.form.reason = '';\n        this.form.startTime = '';\n        this.form.endTime = '';\n        this.form.attachmentUrl = '';\n      } catch (error) {\n        ElMessage.error('提交失败: ' + (error.response?.data || error.message));\n      } finally {\n        this.isSubmitting = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["getLeaveTypes","submitApplication","getUser","ElMessage","EditPen","Phone","CircleCheck","name","components","data","leaveTypes","userInfo","username","realName","className","form","applicantId","leaveTypeId","startTime","endTime","reason","contactPhone","attachmentUrl","isSubmitting","backendUrl","created","user","id","phone","$router","push","fetchLeaveTypes","methods","response","error","console","beforeUpload","file","isLt5M","size","handleUploadSuccess","res","success","handleUploadError","handleSubmit","warning","Date","message"],"sources":["C:\\ThesisProject\\frontend\\src\\views\\student\\ApplyLeave.vue"],"sourcesContent":["<template>\n  <div class=\"apply-container\">\n    <el-card class=\"apply-card\">\n      <template #header>\n        <div class=\"card-header\">\n          <h3><el-icon><EditPen /></el-icon> 申请请假</h3>\n        </div>\n      </template>\n\n      <el-form :model=\"form\" @submit.prevent=\"handleSubmit\" label-width=\"100px\" label-position=\"top\">\n        \n        <!-- 个人信息 (只读) -->\n        <el-row :gutter=\"20\">\n          <el-col :span=\"8\">\n            <el-form-item label=\"学号\">\n              <el-input v-model=\"userInfo.username\" disabled />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item label=\"姓名\">\n              <el-input v-model=\"userInfo.realName\" disabled />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item label=\"班级\">\n              <el-input v-model=\"userInfo.className\" disabled />\n            </el-form-item>\n          </el-col>\n        </el-row>\n\n        <el-form-item label=\"联系电话\" required>\n          <el-input v-model=\"form.contactPhone\" placeholder=\"辅导员能联系到你的电话\" prefix-icon=\"Phone\" />\n        </el-form-item>\n\n        <el-form-item label=\"请假类型\" required>\n          <el-select v-model=\"form.leaveTypeId\" placeholder=\"请选择类型\" class=\"w-100\">\n            <el-option \n              v-for=\"type in leaveTypes\" \n              :key=\"type.id\" \n              :label=\"type.name\" \n              :value=\"type.id\" \n            />\n          </el-select>\n        </el-form-item>\n\n        <el-row :gutter=\"20\">\n          <el-col :span=\"12\">\n            <el-form-item label=\"开始时间\" required>\n              <el-date-picker\n                v-model=\"form.startTime\"\n                type=\"datetime\"\n                placeholder=\"选择开始时间\"\n                class=\"w-100\"\n                value-format=\"YYYY-MM-DD HH:mm:ss\"\n              />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"12\">\n            <el-form-item label=\"结束时间\" required>\n              <el-date-picker\n                v-model=\"form.endTime\"\n                type=\"datetime\"\n                placeholder=\"选择结束时间\"\n                class=\"w-100\"\n                value-format=\"YYYY-MM-DD HH:mm:ss\"\n              />\n            </el-form-item>\n          </el-col>\n        </el-row>\n\n        <el-form-item label=\"请假事由\" required>\n          <el-input \n            v-model=\"form.reason\" \n            type=\"textarea\" \n            :rows=\"4\" \n            placeholder=\"请详细说明请假原因...\" \n          />\n        </el-form-item>\n\n        <el-form-item label=\"附件证明 (图片/PDF)\">\n          <el-upload\n            class=\"upload-demo\"\n            action=\"http://localhost:8080/api/upload\"\n            :show-file-list=\"false\"\n            :on-success=\"handleUploadSuccess\"\n            :on-error=\"handleUploadError\"\n            :before-upload=\"beforeUpload\"\n          >\n            <el-button v-if=\"!form.attachmentUrl\" type=\"primary\">点击上传</el-button>\n            <div v-else class=\"uploaded-file\">\n              <el-icon color=\"#67C23A\"><CircleCheck /></el-icon> \n              <span class=\"success-text\">已上传</span>\n              <el-link :href=\"backendUrl + form.attachmentUrl\" target=\"_blank\" type=\"primary\" class=\"ml-2\">查看附件</el-link>\n              <el-button link type=\"danger\" @click.stop=\"form.attachmentUrl = ''\" class=\"ml-2\">删除</el-button>\n            </div>\n            <template #tip>\n              <div class=\"el-upload__tip\">\n                支持 jpg/png/pdf 文件，且不超过 5MB\n              </div>\n            </template>\n          </el-upload>\n        </el-form-item>\n\n        <el-form-item>\n          <el-button type=\"primary\" size=\"large\" :loading=\"isSubmitting\" @click=\"handleSubmit\" class=\"submit-btn\">\n            提交申请\n          </el-button>\n        </el-form-item>\n\n      </el-form>\n    </el-card>\n  </div>\n</template>\n\n<script>\nimport { getLeaveTypes, submitApplication } from '@/api/leave'\nimport { getUser } from '@/utils/auth'\nimport { ElMessage } from 'element-plus'\nimport { EditPen, Phone, CircleCheck } from '@element-plus/icons-vue'\n\nexport default {\n  name: 'ApplyLeave',\n  components: { EditPen, Phone, CircleCheck },\n  data() {\n    return {\n      leaveTypes: [],\n      userInfo: {\n        username: '',\n        realName: '',\n        className: ''\n      },\n      form: {\n        applicantId: '',\n        leaveTypeId: '',\n        startTime: '',\n        endTime: '',\n        reason: '',\n        contactPhone: '',\n        attachmentUrl: ''\n      },\n      isSubmitting: false,\n      backendUrl: 'http://localhost:8080'\n    }\n  },\n  created() {\n    const user = getUser()\n    if (user) {\n      this.form.applicantId = user.id\n      this.userInfo.username = user.username\n      this.userInfo.realName = user.realName\n      this.userInfo.className = user.className || '未知班级'\n      if (user.phone) this.form.contactPhone = user.phone\n    } else {\n      this.$router.push('/login')\n    }\n    this.fetchLeaveTypes()\n  },\n  methods: {\n    async fetchLeaveTypes() {\n      try {\n        const response = await getLeaveTypes()\n        this.leaveTypes = response || []\n      } catch (error) {\n        console.error('Failed to load leave types', error)\n      }\n    },\n    beforeUpload(file) {\n      const isLt5M = file.size / 1024 / 1024 < 5\n      if (!isLt5M) {\n        ElMessage.error('上传文件大小不能超过 5MB!')\n      }\n      return isLt5M\n    },\n    handleUploadSuccess(res) {\n      // res is the file path returned by backend string\n      this.form.attachmentUrl = res\n      ElMessage.success('上传成功')\n    },\n    handleUploadError() {\n      ElMessage.error('上传失败，请重试')\n    },\n    async handleSubmit() {\n      if (!this.form.leaveTypeId || !this.form.startTime || !this.form.endTime || !this.form.reason || !this.form.contactPhone) {\n        ElMessage.warning('请填写所有必填项')\n        return\n      }\n      \n      if (new Date(this.form.startTime) >= new Date(this.form.endTime)) {\n        ElMessage.warning('结束时间必须晚于开始时间')\n        return\n      }\n\n      this.isSubmitting = true\n      try {\n        await submitApplication(this.form)\n        ElMessage.success('申请提交成功！')\n        // Reset fields\n        this.form.reason = ''\n        this.form.startTime = ''\n        this.form.endTime = ''\n        this.form.attachmentUrl = ''\n      } catch (error) {\n        ElMessage.error('提交失败: ' + (error.response?.data || error.message))\n      } finally {\n        this.isSubmitting = false\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.apply-container {\n  max-width: 800px;\n  margin: 20px auto;\n}\n.card-header {\n  display: flex;\n  align-items: center;\n}\n.card-header h3 {\n  margin: 0;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n.w-100 {\n  width: 100%;\n}\n.uploaded-file {\n  display: flex;\n  align-items: center;\n  background: #f0f9eb;\n  padding: 5px 15px;\n  border-radius: 4px;\n}\n.success-text {\n  margin-left: 5px;\n  color: #67C23A;\n  font-size: 14px;\n}\n.ml-2 {\n  margin-left: 10px;\n}\n.submit-btn {\n  width: 200px;\n  margin-top: 20px;\n}\n</style>\n"],"mappings":"AAmHA,SAASA,aAAa,EAAEC,iBAAgB,QAAS,aAAY;AAC7D,SAASC,OAAM,QAAS,cAAa;AACrC,SAASC,SAAQ,QAAS,cAAa;AACvC,SAASC,OAAO,EAAEC,KAAK,EAAEC,WAAU,QAAS,yBAAwB;AAEpE,eAAe;EACbC,IAAI,EAAE,YAAY;EAClBC,UAAU,EAAE;IAAEJ,OAAO;IAAEC,KAAK;IAAEC;EAAY,CAAC;EAC3CG,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,UAAU,EAAE,EAAE;MACdC,QAAQ,EAAE;QACRC,QAAQ,EAAE,EAAE;QACZC,QAAQ,EAAE,EAAE;QACZC,SAAS,EAAE;MACb,CAAC;MACDC,IAAI,EAAE;QACJC,WAAW,EAAE,EAAE;QACfC,WAAW,EAAE,EAAE;QACfC,SAAS,EAAE,EAAE;QACbC,OAAO,EAAE,EAAE;QACXC,MAAM,EAAE,EAAE;QACVC,YAAY,EAAE,EAAE;QAChBC,aAAa,EAAE;MACjB,CAAC;MACDC,YAAY,EAAE,KAAK;MACnBC,UAAU,EAAE;IACd;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,MAAMC,IAAG,GAAIxB,OAAO,CAAC;IACrB,IAAIwB,IAAI,EAAE;MACR,IAAI,CAACX,IAAI,CAACC,WAAU,GAAIU,IAAI,CAACC,EAAC;MAC9B,IAAI,CAAChB,QAAQ,CAACC,QAAO,GAAIc,IAAI,CAACd,QAAO;MACrC,IAAI,CAACD,QAAQ,CAACE,QAAO,GAAIa,IAAI,CAACb,QAAO;MACrC,IAAI,CAACF,QAAQ,CAACG,SAAQ,GAAIY,IAAI,CAACZ,SAAQ,IAAK,MAAK;MACjD,IAAIY,IAAI,CAACE,KAAK,EAAE,IAAI,CAACb,IAAI,CAACM,YAAW,GAAIK,IAAI,CAACE,KAAI;IACpD,OAAO;MACL,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC,QAAQ;IAC5B;IACA,IAAI,CAACC,eAAe,CAAC;EACvB,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,eAAeA,CAAA,EAAG;MACtB,IAAI;QACF,MAAME,QAAO,GAAI,MAAMjC,aAAa,CAAC;QACrC,IAAI,CAACU,UAAS,GAAIuB,QAAO,IAAK,EAAC;MACjC,EAAE,OAAOC,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,4BAA4B,EAAEA,KAAK;MACnD;IACF,CAAC;IACDE,YAAYA,CAACC,IAAI,EAAE;M