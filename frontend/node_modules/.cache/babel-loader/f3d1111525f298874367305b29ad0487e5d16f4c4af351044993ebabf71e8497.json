{"ast":null,"code":"import { register } from '@/api/auth';\nexport default {\n  name: 'Register',\n  data() {\n    return {\n      form: {\n        username: '',\n        realName: '',\n        password: '',\n        role: 'STUDENT',\n        departmentId: 1,\n        className: ''\n      },\n      loading: false,\n      error: ''\n    };\n  },\n  methods: {\n    async handleRegister() {\n      this.loading = true;\n      this.error = '';\n      try {\n        await register(this.form);\n        alert('注册成功，请登录');\n        this.$router.push('/login');\n      } catch (err) {\n        this.error = err.response?.data || '注册失败';\n      } finally {\n        this.loading = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["register","name","data","form","username","realName","password","role","departmentId","className","loading","error","methods","handleRegister","alert","$router","push","err","response"],"sources":["C:\\ThesisProject\\frontend\\src\\views\\Register.vue"],"sourcesContent":["<template>\n  <div class=\"auth-container\">\n    <h2>注册</h2>\n    <form @submit.prevent=\"handleRegister\">\n      <div class=\"form-group\">\n        <label>用户名:</label>\n        <input type=\"text\" v-model=\"form.username\" required placeholder=\"请输入学号或工号\" />\n      </div>\n      <div class=\"form-group\">\n        <label>真实姓名:</label>\n        <input type=\"text\" v-model=\"form.realName\" required />\n      </div>\n      <div class=\"form-group\">\n        <label>密码:</label>\n        <input type=\"password\" v-model=\"form.password\" required />\n      </div>\n      \n      <div class=\"form-group\">\n        <label>角色:</label>\n        <select v-model=\"form.role\">\n          <option value=\"STUDENT\">学生</option>\n          <option value=\"TEACHER\">教师</option>\n          <option value=\"ADMIN\">管理员</option>\n        </select>\n      </div>\n\n      <!-- 动态显示的班级输入框 -->\n      <div class=\"form-group\" v-if=\"form.role\">\n        <label>{{ form.role === 'STUDENT' ? '所在班级' : '管理班级' }}:</label>\n        <input \n          type=\"text\" \n          v-model=\"form.className\" \n          :placeholder=\"form.role === 'STUDENT' ? '例如: 2023级1班' : '例如: 2023级1班, 2班'\" \n          required \n        />\n      </div>\n\n      <div class=\"form-group\">\n        <label>院系ID (默认为1-计算机系):</label>\n        <input type=\"number\" v-model.number=\"form.departmentId\" />\n      </div>\n      \n      <button type=\"submit\" :disabled=\"loading\">注册</button>\n      <div class=\"links\">\n        <router-link to=\"/login\">已有账号？去登录</router-link>\n      </div>\n    </form>\n    <div v-if=\"error\" class=\"error\">{{ error }}</div>\n  </div>\n</template>\n\n<script>\nimport { register } from '@/api/auth'\n\nexport default {\n  name: 'Register',\n  data() {\n    return {\n      form: {\n        username: '',\n        realName: '',\n        password: '',\n        role: 'STUDENT',\n        departmentId: 1,\n        className: ''\n      },\n      loading: false,\n      error: ''\n    }\n  },\n  methods: {\n    async handleRegister() {\n      this.loading = true\n      this.error = ''\n      try {\n        await register(this.form)\n        alert('注册成功，请登录')\n        this.$router.push('/login')\n      } catch (err) {\n        this.error = err.response?.data || '注册失败'\n      } finally {\n        this.loading = false\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.auth-container {\n  max-width: 400px;\n  margin: 50px auto;\n  padding: 30px;\n  border: 1px solid #eee;\n  border-radius: 8px;\n  box-shadow: 0 2px 12px 0 rgba(0,0,0,0.1);\n  background: white;\n}\n.form-group {\n  margin-bottom: 20px;\n}\n.form-group label {\n  display: block;\n  margin-bottom: 5px;\n  font-weight: 500;\n  color: #555;\n}\n.form-group input, .form-group select {\n  width: 100%;\n  padding: 10px;\n  box-sizing: border-box;\n  border: 1px solid #ddd;\n  border-radius: 4px;\n}\nbutton {\n  width: 100%;\n  padding: 12px;\n  background-color: #67C23A;\n  color: white;\n  border: none;\n  border-radius: 4px;\n  cursor: pointer;\n  font-size: 16px;\n}\nbutton:hover {\n  background-color: #85ce61;\n}\n.links {\n  margin-top: 15px;\n  text-align: right;\n}\n.links a {\n  color: #409EFF;\n  text-decoration: none;\n}\n.error {\n  color: #F56C6C;\n  margin-top: 10px;\n  text-align: center;\n}\n</style>\n"],"mappings":"AAoDA,SAASA,QAAO,QAAS,YAAW;AAEpC,eAAe;EACbC,IAAI,EAAE,UAAU;EAChBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE;QACJC,QAAQ,EAAE,EAAE;QACZC,QAAQ,EAAE,EAAE;QACZC,QAAQ,EAAE,EAAE;QACZC,IAAI,EAAE,SAAS;QACfC,YAAY,EAAE,CAAC;QACfC,SAAS,EAAE;MACb,CAAC;MACDC,OAAO,EAAE,KAAK;MACdC,KAAK,EAAE;IACT;EACF,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,cAAcA,CAAA,EAAG;MACrB,IAAI,CAACH,OAAM,GAAI,IAAG;MAClB,IAAI,CAACC,KAAI,GAAI,EAAC;MACd,IAAI;QACF,MAAMX,QAAQ,CAAC,IAAI,CAACG,IAAI;QACxBW,KAAK,CAAC,UAAU;QAChB,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC,QAAQ;MAC5B,EAAE,OAAOC,GAAG,EAAE;QACZ,IAAI,CAACN,KAAI,GAAIM,GAAG,CAACC,QAAQ,EAAEhB,IAAG,IAAK,MAAK;MAC1C,UAAU;QACR,IAAI,CAACQ,OAAM,GAAI,KAAI;MACrB;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}