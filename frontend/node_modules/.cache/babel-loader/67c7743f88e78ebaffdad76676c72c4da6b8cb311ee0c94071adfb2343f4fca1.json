{"ast":null,"code":"import { getNotifications } from '@/api/notification';\nimport { getUser } from '@/utils/auth';\nexport default {\n  name: 'Notifications',\n  data() {\n    return {\n      list: []\n    };\n  },\n  created() {\n    const user = getUser();\n    if (user) {\n      this.fetchData(user.id);\n    }\n  },\n  methods: {\n    async fetchData(id) {\n      try {\n        const res = await getNotifications(id);\n        this.list = res || [];\n      } catch (e) {\n        console.error(e);\n      }\n    },\n    formatTime(time) {\n      if (!time) return '';\n      return new Date(time).toLocaleString();\n    }\n  }\n};","map":{"version":3,"names":["getNotifications","getUser","name","data","list","created","user","fetchData","id","methods","res","e","console","error","formatTime","time","Date","toLocaleString"],"sources":["C:\\ThesisProject\\frontend\\src\\views\\student\\Notifications.vue"],"sourcesContent":["<template>\r\n  <div class=\"notification-container\">\r\n    <h2>消息通知</h2>\r\n    <div v-if=\"list.length === 0\" class=\"no-data\">暂无消息</div>\r\n    <ul class=\"notification-list\">\r\n      <li v-for=\"item in list\" :key=\"item.id\" :class=\"{ unread: item.isRead === 0 }\">\r\n        <div class=\"content\">{{ item.content }}</div>\r\n        <div class=\"time\">{{ formatTime(item.createdAt) }}</div>\r\n      </li>\r\n    </ul>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { getNotifications } from '@/api/notification'\r\nimport { getUser } from '@/utils/auth'\r\n\r\nexport default {\r\n  name: 'Notifications',\r\n  data() {\r\n    return {\r\n      list: []\r\n    }\r\n  },\r\n  created() {\r\n    const user = getUser()\r\n    if (user) {\r\n      this.fetchData(user.id)\r\n    }\r\n  },\r\n  methods: {\r\n    async fetchData(id) {\r\n      try {\r\n        const res = await getNotifications(id)\r\n        this.list = res || []\r\n      } catch (e) {\r\n        console.error(e)\r\n      }\r\n    },\r\n    formatTime(time) {\r\n      if (!time) return ''\r\n      return new Date(time).toLocaleString()\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.notification-container {\r\n  padding: 20px;\r\n  max-width: 600px;\r\n  margin: 0 auto;\r\n}\r\n.notification-list {\r\n  list-style: none;\r\n  padding: 0;\r\n}\r\n.notification-list li {\r\n  padding: 15px;\r\n  border-bottom: 1px solid #eee;\r\n  background: #fff;\r\n}\r\n.notification-list li.unread {\r\n  background: #f0f9eb;\r\n  border-left: 4px solid #67C23A;\r\n}\r\n.time {\r\n  font-size: 0.85em;\r\n  color: #999;\r\n  margin-top: 5px;\r\n}\r\n</style>\r\n"],"mappings":"AAcA,SAASA,gBAAe,QAAS,oBAAmB;AACpD,SAASC,OAAM,QAAS,cAAa;AAErC,eAAe;EACbC,IAAI,EAAE,eAAe;EACrBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE;IACR;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,MAAMC,IAAG,GAAIL,OAAO,CAAC;IACrB,IAAIK,IAAI,EAAE;MACR,IAAI,CAACC,SAAS,CAACD,IAAI,CAACE,EAAE;IACxB;EACF,CAAC;EACDC,OAAO,EAAE;IACP,MAAMF,SAASA,CAACC,EAAE,EAAE;MAClB,IAAI;QACF,MAAME,GAAE,GAAI,MAAMV,gBAAgB,CAACQ,EAAE;QACrC,IAAI,CAACJ,IAAG,GAAIM,GAAE,IAAK,EAAC;MACtB,EAAE,OAAOC,CAAC,EAAE;QACVC,OAAO,CAACC,KAAK,CAACF,CAAC;MACjB;IACF,CAAC;IACDG,UAAUA,CAACC,IAAI,EAAE;MACf,IAAI,CAACA,IAAI,EAAE,OAAO,EAAC;MACnB,OAAO,IAAIC,IAAI,CAACD,IAAI,CAAC,CAACE,cAAc,CAAC;IACvC;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}