{"ast":null,"code":"import { getMyHistory } from '@/api/leave';\nimport { getUser } from '@/utils/auth';\nexport default {\n  name: 'MyLeaves',\n  data() {\n    return {\n      list: [],\n      pageNum: 1,\n      pageSize: 10,\n      total: 0,\n      pages: 0,\n      studentId: null\n    };\n  },\n  created() {\n    const user = getUser();\n    if (user) {\n      this.studentId = user.id;\n      this.fetchData();\n    }\n  },\n  methods: {\n    async fetchData() {\n      if (!this.studentId) return;\n      try {\n        const res = await getMyHistory(this.studentId, this.pageNum, this.pageSize);\n        // PageHelper returns: { list: [], total: 100, pages: 10, ... }\n        if (res) {\n          this.list = res.list;\n          this.total = res.total;\n          this.pages = res.pages;\n        }\n      } catch (e) {\n        console.error(e);\n      }\n    },\n    handleSizeChange() {\n      this.pageNum = 1; // Reset to first page\n      this.fetchData();\n    },\n    changePage(newPage) {\n      this.pageNum = newPage;\n      this.fetchData();\n    },\n    formatTime(time) {\n      if (!time) return '';\n      return new Date(time).toLocaleString();\n    }\n  }\n};","map":{"version":3,"names":["getMyHistory","getUser","name","data","list","pageNum","pageSize","total","pages","studentId","created","user","id","fetchData","methods","res","e","console","error","handleSizeChange","changePage","newPage","formatTime","time","Date","toLocaleString"],"sources":["C:\\ThesisProject\\frontend\\src\\views\\student\\MyLeaves.vue"],"sourcesContent":["<template>\r\n  <div class=\"my-leaves-container\">\r\n    <h2>我的申请记录</h2>\r\n    <table class=\"data-table\">\r\n      <thead>\r\n        <tr>\r\n          <th>申请ID</th>\r\n          <th>类型ID</th>\r\n          <th>开始时间</th>\r\n          <th>结束时间</th>\r\n          <th>状态</th>\r\n          <th>当前步骤</th>\r\n          <th>申请时间</th>\r\n        </tr>\r\n      </thead>\r\n      <tbody>\r\n        <tr v-for=\"item in list\" :key=\"item.id\">\r\n          <td>{{ item.id }}</td>\r\n          <td>{{ item.leaveTypeId }}</td>\r\n          <td>{{ formatTime(item.startTime) }}</td>\r\n          <td>{{ formatTime(item.endTime) }}</td>\r\n          <td>\r\n            <span :class=\"'status-' + item.status.toLowerCase()\">{{ item.status }}</span>\r\n          </td>\r\n          <td>{{ item.currentStep }}</td>\r\n          <td>{{ formatTime(item.createdAt) }}</td>\r\n        </tr>\r\n      </tbody>\r\n    </table>\r\n\r\n    <!-- Pagination Controls -->\r\n    <div class=\"pagination\">\r\n      <div class=\"page-size-selector\">\r\n        每页显示:\r\n        <select v-model=\"pageSize\" @change=\"handleSizeChange\">\r\n          <option :value=\"1\">1条 (测试)</option>\r\n          <option :value=\"10\">10条</option>\r\n          <option :value=\"20\">20条</option>\r\n          <option :value=\"50\">50条</option>\r\n          <option :value=\"100\">100条</option>\r\n        </select>\r\n      </div>\r\n      \r\n      <div class=\"page-nav\">\r\n        <button :disabled=\"pageNum <= 1\" @click=\"changePage(pageNum - 1)\">上一页</button>\r\n        <span>第 {{ pageNum }} 页 / 共 {{ pages }} 页 (总数: {{ total }})</span>\r\n        <button :disabled=\"pageNum >= pages\" @click=\"changePage(pageNum + 1)\">下一页</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { getMyHistory } from '@/api/leave'\r\nimport { getUser } from '@/utils/auth'\r\n\r\nexport default {\r\n  name: 'MyLeaves',\r\n  data() {\r\n    return {\r\n      list: [],\r\n      pageNum: 1,\r\n      pageSize: 10,\r\n      total: 0,\r\n      pages: 0,\r\n      studentId: null\r\n    }\r\n  },\r\n  created() {\r\n    const user = getUser()\r\n    if (user) {\r\n      this.studentId = user.id\r\n      this.fetchData()\r\n    }\r\n  },\r\n  methods: {\r\n    async fetchData() {\r\n      if (!this.studentId) return\r\n      try {\r\n        const res = await getMyHistory(this.studentId, this.pageNum, this.pageSize)\r\n        // PageHelper returns: { list: [], total: 100, pages: 10, ... }\r\n        if (res) {\r\n          this.list = res.list\r\n          this.total = res.total\r\n          this.pages = res.pages\r\n        }\r\n      } catch (e) {\r\n        console.error(e)\r\n      }\r\n    },\r\n    handleSizeChange() {\r\n      this.pageNum = 1 // Reset to first page\r\n      this.fetchData()\r\n    },\r\n    changePage(newPage) {\r\n      this.pageNum = newPage\r\n      this.fetchData()\r\n    },\r\n    formatTime(time) {\r\n      if (!time) return ''\r\n      return new Date(time).toLocaleString()\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.my-leaves-container {\r\n  padding: 20px;\r\n}\r\n.data-table {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n  margin-top: 15px;\r\n}\r\n.data-table th, .data-table td {\r\n  border: 1px solid #ddd;\r\n  padding: 10px;\r\n  text-align: left;\r\n}\r\n.status-approved { color: green; font-weight: bold; }\r\n.status-rejected { color: red; font-weight: bold; }\r\n.status-pending { color: orange; }\r\n\r\n.pagination {\r\n  margin-top: 20px;\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  padding: 10px;\r\n  background: #f9f9f9;\r\n  border-radius: 4px;\r\n}\r\n.page-nav button {\r\n  padding: 5px 10px;\r\n  margin: 0 10px;\r\n  cursor: pointer;\r\n}\r\n.page-nav button:disabled {\r\n  cursor: not-allowed;\r\n  opacity: 0.5;\r\n}\r\n</style>\r\n"],"mappings":"AAqDA,SAASA,YAAW,QAAS,aAAY;AACzC,SAASC,OAAM,QAAS,cAAa;AAErC,eAAe;EACbC,IAAI,EAAE,UAAU;EAChBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE,EAAE;MACRC,OAAO,EAAE,CAAC;MACVC,QAAQ,EAAE,EAAE;MACZC,KAAK,EAAE,CAAC;MACRC,KAAK,EAAE,CAAC;MACRC,SAAS,EAAE;IACb;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,MAAMC,IAAG,GAAIV,OAAO,CAAC;IACrB,IAAIU,IAAI,EAAE;MACR,IAAI,CAACF,SAAQ,GAAIE,IAAI,CAACC,EAAC;MACvB,IAAI,CAACC,SAAS,CAAC;IACjB;EACF,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,SAASA,CAAA,EAAG;MAChB,IAAI,CAAC,IAAI,CAACJ,SAAS,EAAE;MACrB,IAAI;QACF,MAAMM,GAAE,GAAI,MAAMf,YAA