User()\r\n      this.user = null\r\n      this.$router.push('/login')\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style>\r\n#app {\r\n  font-family: Avenir, Helvetica, Arial, sans-serif;\r\n  -webkit-font-smoothing: antialiased;\r\n  -moz-osx-font-smoothing: grayscale;\r\n  text-align: center;\r\n  color: #2c3e50;\r\n  margin-top: 60px;\r\n}\r\n\r\nnav {\r\n  padding: 30px;\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  gap: 20px;\r\n}\r\n\r\nnav a {\r\n  font-weight: bold;\r\n  color: #2c3e50;\r\n  text-decoration: none;\r\n}\r\n\r\nnav a.router-link-exact-active {\r\n  color: #42b983;\r\n}\r\n\r\n.user-info {\r\n  margin-right: 20px;\r\n  color: #666;\r\n}\r\n\r\n.logout-btn {\r\n  color: #f56c6c;\r\n  cursor: pointer;\r\n}\r\n</style>\r\n"],"mappings":"AAqBA,SAASA,OAAO,EAAEC,UAAS,QAAS,cAAa;AAEjD,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE;IACR;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,SAAS,CAAC;EACjB,CAAC;EACDC,KAAK,EAAE;IACLC,MAAMA,CAAA,EAAG;MACP,IAAI,CAACF,SAAS,CAAC;IACjB;EACF,CAAC;EACDG,OAAO,EAAE;IACPH,SAASA,CAAA,EAAG;MACV,IAAI,CAACF,IAAG,GAAIH,OAAO,CAAC;IACtB,CAAC;IACDS,MAAMA,CAAA,EAAG;MACPR,UAAU,CAAC;MACX,IAAI,CAACE,IAAG,GAAI,IAAG;MACf,IAAI,CAACO,OAAO,CAACC,IAAI,CAAC,QAAQ;IAC5B;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}