{"ast":null,"code":"import { getDashboardStats, getApprovalHistory } from '@/api/approval';\nimport { getUser } from '@/utils/auth';\nimport { Document } from '@element-plus/icons-vue';\nexport default {\n  name: 'TeacherDashboard',\n  components: {\n    Document\n  },\n  data() {\n    return {\n      stats: {\n        todayLeaveCount: 0,\n        myProcessedCount: 0\n      },\n      history: [],\n      showModal: false,\n      currentItem: null,\n      backendUrl: 'http://localhost:8080'\n    };\n  },\n  created() {\n    const user = getUser();\n    if (user) {\n      this.loadData(user.id);\n    }\n  },\n  methods: {\n    async loadData(id) {\n      try {\n        const [statsRes, historyRes] = await Promise.all([getDashboardStats(id), getApprovalHistory(id)]);\n        this.stats = statsRes || {\n          todayLeaveCount: 0,\n          myProcessedCount: 0\n        };\n        this.history = historyRes || [];\n      } catch (e) {\n        console.error(e);\n      }\n    },\n    formatTime(time) {\n      if (!time) return '';\n      return new Date(time).toLocaleString();\n    },\n    openDetail(item) {\n      this.currentItem = item;\n      this.showModal = true;\n    }\n  }\n};","map":{"version":3,"names":["getDashboardStats","getApprovalHistory","getUser","Document","name","components","data","stats","todayLeaveCount","myProcessedCount","history","showModal","currentItem","backendUrl","created","user","loadData","id","methods","statsRes","historyRes","Promise","all","e","console","error","formatTime","time","Date","toLocaleString","openDetail","item"],"sources":["C:\\ThesisProject\\frontend\\src\\views\\teacher\\Dashboard.vue"],"sourcesContent":["<template>\n  <div class=\"dashboard-container\">\n    <h2>数据看板</h2>\n    \n    <!-- 统计卡片 -->\n    <el-row :gutter=\"20\" class=\"mb-4\">\n      <el-col :span=\"12\">\n        <el-card shadow=\"hover\">\n          <template #header>\n            <div class=\"card-header\">\n              <span>今日全校请假数</span>\n            </div>\n          </template>\n          <div class=\"stat-number\">{{ stats.todayLeaveCount }}</div>\n        </el-card>\n      </el-col>\n      <el-col :span=\"12\">\n        <el-card shadow=\"hover\">\n          <template #header>\n            <div class=\"card-header\">\n              <span>我今日处理单数</span>\n            </div>\n          </template>\n          <div class=\"stat-number\">{{ stats.myProcessedCount }}</div>\n        </el-card>\n      </el-col>\n    </el-row>\n\n    <h2>审批历史记录</h2>\n    <el-card shadow=\"never\">\n      <el-table :data=\"history\" stripe style=\"width: 100%\">\n        <el-table-column prop=\"recordId\" label=\"ID\" width=\"80\" />\n        <el-table-column prop=\"realName\" label=\"申请人\" width=\"120\" />\n        <el-table-column prop=\"className\" label=\"班级\" width=\"150\" />\n        <el-table-column prop=\"leaveTypeName\" label=\"类型\" width=\"100\" />\n        <el-table-column label=\"电话\" width=\"150\">\n          <template #default=\"scope\">\n            {{ scope.row.contactPhone || '-' }}\n          </template>\n        </el-table-column>\n        <el-table-column label=\"附件\" width=\"80\">\n          <template #default=\"scope\">\n            <el-link \n              v-if=\"scope.row.attachmentUrl\" \n              :href=\"backendUrl + scope.row.attachmentUrl\" \n              target=\"_blank\" \n              type=\"primary\"\n              :underline=\"false\"\n            >\n              <el-icon><Document /></el-icon>\n            </el-link>\n            <span v-else>-</span>\n          </template>\n        </el-table-column>\n        <el-table-column label=\"我的操作\" width=\"100\">\n          <template #default=\"scope\">\n            <el-tag :type=\"scope.row.action === 'APPROVE' ? 'success' : 'danger'\">\n              {{ scope.row.action === 'APPROVE' ? '通过' : '驳回' }}\n            </el-tag>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"comment\" label=\"我的意见\" show-overflow-tooltip />\n        <el-table-column label=\"操作时间\" width=\"180\">\n          <template #default=\"scope\">\n            {{ formatTime(scope.row.actionTime) }}\n          </template>\n        </el-table-column>\n        <el-table-column label=\"操作\" width=\"100\" fixed=\"right\">\n          <template #default=\"scope\">\n            <el-button size=\"small\" @click=\"openDetail(scope.row)\">查看</el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n    </el-card>\n\n    <!-- 详情弹窗 -->\n    <el-dialog v-model=\"showModal\" title=\"申请详情回顾\" width=\"500px\">\n      <div v-if=\"currentItem\" class=\"detail-content\">\n        <div class=\"detail-row\">\n          <span class=\"label\">申请人:</span> \n          <span class=\"value\">{{ currentItem.realName }} (ID: {{ currentItem.applicantId }})</span>\n        </div>\n        <div class=\"detail-row\">\n          <span class=\"label\">班级:</span> \n          <span class=\"value\">{{ currentItem.className }}</span>\n        </div>\n        <div class=\"detail-row\">\n          <span class=\"label\">请假类型:</span> \n          <span class=\"value\">{{ currentItem.leaveTypeName }}</span>\n        </div>\n        <div class=\"detail-row\">\n          <span class=\"label\">时间:</span> \n          <span class=\"value\">\n            {{ formatTime(currentItem.startTime) }} - {{ formatTime(currentItem.endTime) }}\n            ({{ currentItem.durationHours }}小时)\n          </span>\n        </div>\n        <div class=\"detail-row\">\n          <span class=\"label\">事由:</span> \n          <div class=\"reason-box\">{{ currentItem.reason }}</div>\n        </div>\n        <div class=\"detail-row\" v-if=\"currentItem.attachmentUrl\">\n          <span class=\"label\">附件:</span>\n          <el-link :href=\"backendUrl + currentItem.attachmentUrl\" target=\"_blank\" type=\"primary\">点击查看附件</el-link>\n        </div>\n      </div>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nimport { getDashboardStats, getApprovalHistory } from '@/api/approval'\nimport { getUser } from '@/utils/auth'\nimport { Document } from '@element-plus/icons-vue'\n\nexport default {\n  name: 'TeacherDashboard',\n  components: { Document },\n  data() {\n    return {\n      stats: {\n        todayLeaveCount: 0,\n        myProcessedCount: 0\n      },\n      history: [],\n      showModal: false,\n      currentItem: null,\n      backendUrl: 'http://localhost:8080'\n    }\n  },\n  created() {\n    const user = getUser()\n    if (user) {\n      this.loadData(user.id)\n    }\n  },\n  methods: {\n    async loadData(id) {\n      try {\n        const [statsRes, historyRes] = await Promise.all([\n          getDashboardStats(id),\n          getApprovalHistory(id)\n        ])\n        this.stats = statsRes || { todayLeaveCount: 0, myProcessedCount: 0 }\n        this.history = historyRes || []\n      } catch (e) {\n        console.error(e)\n      }\n    },\n    formatTime(time) {\n      if (!time) return ''\n      return new Date(time).toLocaleString()\n    },\n    openDetail(item) {\n      this.currentItem = item\n      this.showModal = true\n    }\n  }\n}\n</script>\n\n<style scoped>\n.dashboard-container {\n  /* padding: 20px; handled by main-content */\n}\n.mb-4 {\n  margin-bottom: 20px;\n}\n.stat-number {\n  font-size: 32px;\n  font-weight: bold;\n  color: #409EFF;\n  text-align: center;\n  padding: 10px 0;\n}\n.detail-row {\n  margin-bottom: 12px;\n  display: flex;\n}\n.detail-row .label {\n  font-weight: bold;\n  color: #606266;\n  width: 80px;\n  flex-shrink: 0;\n}\n.detail-row .value {\n  color: #303133;\n}\n.reason-box {\n  background: #f5f7fa;\n  padding: 10px;\n  border-radius: 4px;\n  color: #606266;\n  flex-grow: 1;\n}\n</style>\n"],"mappings":"AA+GA,SAASA,iBAAiB,EAAEC,kBAAiB,QAAS,gBAAe;AACrE,SAASC,OAAM,QAAS,cAAa;AACrC,SAASC,QAAO,QAAS,yBAAwB;AAEjD,eAAe;EACbC,IAAI,EAAE,kBAAkB;EACxBC,UAAU,EAAE;IAAEF;EAAS,CAAC;EACxBG,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAE;QACLC,eAAe,EAAE,CAAC;QAClBC,gBAAgB,EAAE;MACpB,CAAC;M