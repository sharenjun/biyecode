{"ast":null,"code":"import { getDashboardStats, getApprovalHistory } from '@/api/approval';\nimport { getUser } from '@/utils/auth';\nexport default {\n  name: 'TeacherDashboard',\n  data() {\n    return {\n      stats: {\n        todayLeaveCount: 0,\n        myProcessedCount: 0\n      },\n      history: [],\n      showModal: false,\n      currentItem: null,\n      backendUrl: 'http://localhost:8080'\n    };\n  },\n  created() {\n    const user = getUser();\n    if (user) {\n      this.loadData(user.id);\n    }\n  },\n  methods: {\n    async loadData(id) {\n      try {\n        const [statsRes, historyRes] = await Promise.all([getDashboardStats(id), getApprovalHistory(id)]);\n        this.stats = statsRes || {\n          todayLeaveCount: 0,\n          myProcessedCount: 0\n        };\n        this.history = historyRes || [];\n      } catch (e) {\n        console.error(e);\n      }\n    },\n    formatTime(time) {\n      if (!time) return '';\n      return new Date(time).toLocaleString();\n    },\n    openDetail(item) {\n      this.currentItem = item;\n      this.showModal = true;\n    },\n    closeModal() {\n      this.showModal = false;\n      this.currentItem = null;\n    }\n  }\n};","map":{"version":3,"names":["getDashboardStats","getApprovalHistory","getUser","name","data","stats","todayLeaveCount","myProcessedCount","history","showModal","currentItem","backendUrl","created","user","loadData","id","methods","statsRes","historyRes","Promise","all","e","console","error","formatTime","time","Date","toLocaleString","openDetail","item","closeModal"],"sources":["C:\\ThesisProject\\frontend\\src\\views\\teacher\\Dashboard.vue"],"sourcesContent":["<template>\n  <div class=\"dashboard-container\">\n    <h2>数据看板</h2>\n    \n    <!-- 统计卡片 -->\n    <div class=\"stats-cards\">\n      <div class=\"card\">\n        <h3>今日全校请假数</h3>\n        <div class=\"number\">{{ stats.todayLeaveCount }}</div>\n      </div>\n      <div class=\"card\">\n        <h3>我今日处理单数</h3>\n        <div class=\"number\">{{ stats.myProcessedCount }}</div>\n      </div>\n    </div>\n\n    <h2>审批历史记录</h2>\n    <table class=\"data-table\">\n      <thead>\n        <tr>\n          <th>申请人</th>\n          <th>类型</th>\n          <th>电话</th>\n          <th>附件</th>\n          <th>我的操作</th>\n          <th>我的意见</th>\n          <th>操作时间</th>\n          <th>详情</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr v-for=\"item in history\" :key=\"item.recordId\">\n          <td>{{ item.realName }}</td>\n          <td>{{ item.leaveTypeName }}</td>\n          <td>{{ item.contactPhone || '-' }}</td>\n          <td>\n             <a v-if=\"item.attachmentUrl\" :href=\"backendUrl + item.attachmentUrl\" target=\"_blank\">📄</a>\n             <span v-else>-</span>\n          </td>\n          <td>\n            <span :class=\"item.action === 'APPROVE' ? 'green' : 'red'\">\n              {{ item.action === 'APPROVE' ? '通过' : '驳回' }}\n            </span>\n          </td>\n          <td>{{ item.comment }}</td>\n          <td>{{ formatTime(item.actionTime) }}</td>\n          <td>\n            <button class=\"btn-sm\" @click=\"openDetail(item)\">查看</button>\n          </td>\n        </tr>\n      </tbody>\n    </table>\n\n    <!-- 详情弹窗 -->\n    <div v-if=\"showModal\" class=\"modal-overlay\" @click.self=\"closeModal\">\n      <div class=\"modal\">\n        <div class=\"modal-header\">\n          <h3>申请详情回顾</h3>\n          <span class=\"close-btn\" @click=\"closeModal\">×</span>\n        </div>\n        <div class=\"modal-body\" v-if=\"currentItem\">\n          <div class=\"detail-row\">\n            <label>申请人:</label> {{ currentItem.realName }} (ID: {{ currentItem.applicantId }})\n          </div>\n          <div class=\"detail-row\">\n            <label>请假类型:</label> {{ currentItem.leaveTypeName }}\n          </div>\n          <div class=\"detail-row\">\n            <label>时间:</label> \n            {{ formatTime(currentItem.startTime) }} - {{ formatTime(currentItem.endTime) }}\n            ({{ currentItem.durationHours }}小时)\n          </div>\n          <div class=\"detail-row\">\n            <label>事由:</label> \n            <div class=\"reason-box\">{{ currentItem.reason }}</div>\n          </div>\n           <div class=\"detail-row\" v-if=\"currentItem.attachmentUrl\">\n            <label>附件:</label>\n            <a :href=\"backendUrl + currentItem.attachmentUrl\" target=\"_blank\">点击查看附件</a>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { getDashboardStats, getApprovalHistory } from '@/api/approval'\nimport { getUser } from '@/utils/auth'\n\nexport default {\n  name: 'TeacherDashboard',\n  data() {\n    return {\n      stats: {\n        todayLeaveCount: 0,\n        myProcessedCount: 0\n      },\n      history: [],\n      showModal: false,\n      currentItem: null,\n      backendUrl: 'http://localhost:8080'\n    }\n  },\n  created() {\n    const user = getUser()\n    if (user) {\n      this.loadData(user.id)\n    }\n  },\n  methods: {\n    async loadData(id) {\n      try {\n        const [statsRes, historyRes] = await Promise.all([\n          getDashboardStats(id),\n          getApprovalHistory(id)\n        ])\n        this.stats = statsRes || { todayLeaveCount: 0, myProcessedCount: 0 }\n        this.history = historyRes || []\n      } catch (e) {\n        console.error(e)\n      }\n    },\n    formatTime(time) {\n      if (!time) return ''\n      return new Date(time).toLocaleString()\n    },\n    openDetail(item) {\n      this.currentItem = item\n      this.showModal = true\n    },\n    closeModal() {\n      this.showModal = false\n      this.currentItem = null\n    }\n  }\n}\n</script>\n\n<style scoped>\n.dashboard-container {\n  padding: 20px;\n}\n.stats-cards {\n  display: flex;\n  gap: 20px;\n  margin-bottom: 30px;\n}\n.card {\n  flex: 1;\n  background: #fff;\n  padding: 20px;\n  border-radius: 8px;\n  text-align: center;\n  box-shadow: 0 2px 12px rgba(0,0,0,0.1);\n  border: 1px solid #ebeef5;\n}\n.card h3 {\n  margin: 0;\n  color: #909399;\n  font-size: 14px;\n}\n.card .number {\n  font-size: 32px;\n  font-weight: bold;\n  color: #409EFF;\n  margin-top: 10px;\n}\n.data-table {\n  width: 100%;\n  border-collapse: collapse;\n  background: white;\n  box-shadow: 0 1px 4px rgba(0,0,0,0.05);\n}\n.data-table th, .data-table td {\n  border: 1px solid #ebeef5;\n  padding: 12px;\n  text-align: left;\n}\n.data-table th {\n  background: #fafafa;\n  color: #606266;\n}\n.green { color: #67C23A; font-weight: bold; }\n.red { color: #F56C6C; font-weight: bold; }\n.btn-sm {\n  padding: 4px 8px;\n  background: #909399;\n  color: white;\n  border: none;\n  border-radius: 4px;\n  cursor: pointer;\n}\n.btn-sm:hover { background: #606266; }\n\n/* Modal */\n.modal-overlay {\n  position: fixed;\n  top: 0; left: 0; width: 100%; height: 100%;\n  background: rgba(0,0,0,0.5);\n  display: flex; justify-content: center; align-items: center;\n  z-index: 999;\n}\n.modal {\n  background: white; width: 400px; padding: 20px; border-radius: 8px;\n}\n.modal-header {\n  display: flex; justify-content: space-between; border-bottom: 1px solid #eee; padding-bottom: 10px; margin-bottom: 15px;\n}\n.close-btn { cursor: pointer; font-size: 20px; }\n.detail-row { margin-bottom: 10px; line-height: 1.6; }\n.detail-row label { font-weight: bold; color: #666; display: inline-block; width: 70px; }\n.reason-box { background: #f4f4f5; padding: 8px; border-radius: 4px; color: #606266; margin-top: 5px; }\n</style>\n"],"mappings":"AAuFA,SAASA,iBAAiB,EAAEC,kBAAiB,QAAS,gBAAe;AACrE,SAASC,OAAM,QAAS,cAAa;AAErC,eAAe;EACbC,IAAI,EAAE,kBAAkB;EACxBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAE;QACLC,eAAe,EAAE,CAAC;QAClBC,gBAAgB,EAAE;MACpB,CAAC;MACDC,OAAO,EAAE,EAAE;MACXC,SAAS,EAAE,KAAK;MAChBC,WAAW,EAAE,IAAI;MACjBC,UAAU,EAAE;IACd;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,MAAMC,IAAG,GAAIX,OAAO,CAAC;IACrB,IAAIW,IAAI,EAAE;MACR,IAAI,CAACC,QAAQ,CAACD,IAAI,CAACE,EAAE;IACvB;EACF,CAAC;EACDC,OAAO,EAAE;IACP,MAAMF,QAAQA,CAACC,EAAE,EAAE;MACjB,IAAI;QACF,MAAM,CAACE,QAAQ,EAAEC,UAAU,IAAI,MAAMC,OAAO,CAACC,GAAG,CAAC,CAC/CpB,iBAAiB,CAACe,EAAE,CAAC,EACrBd,kBAAkB,CAACc,EAAE,EACtB;QACD,IAAI,CAACV,KAAI,GAAIY,QAAO,IAAK;UAAEX,eAAe,EAAE,CAAC;UAAEC,gBAAgB,EAAE;QAAE;QACnE,IAAI,CAACC,OAAM,GAAIU,UAAS,IAAK,EAAC;MAChC,EAAE,OAAOG,CAAC,EAAE;QACVC,OAAO,CAACC,KAAK,CAACF,CAAC;MACjB;IACF,CAAC;IACDG,UAAUA,CAACC,IAAI,EAAE;MACf,IAAI,CAACA,IAAI,EAAE,OAAO,EAAC;MACnB,OAAO,IAAIC,IAAI,CAACD,IAAI,CAAC,CAACE,cAAc,CAAC;IACvC,CAAC;IACDC,UAAUA,CAACC,IAAI,EAAE;MACf,IAAI,CAACnB,WAAU,GAAImB,IAAG;MACtB,IAAI,CAACpB,SAAQ,GAAI,IAAG;IACtB,CAAC;IACDqB,UAAUA,CAAA,EAAG;MACX,IAAI,CAACrB,SAAQ,GAAI,KAAI;MACrB,IAAI,CAACC,WAAU,GAAI,IAAG;IACxB;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}