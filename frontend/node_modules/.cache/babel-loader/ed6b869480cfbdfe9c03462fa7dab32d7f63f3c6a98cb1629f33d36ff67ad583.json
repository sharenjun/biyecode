{"ast":null,"code":"import { getMyHistory } from '@/api/leave';\nimport { getUser } from '@/utils/auth';\nexport default {\n  name: 'MyLeaves',\n  data() {\n    return {\n      list: []\n    };\n  },\n  created() {\n    const user = getUser();\n    if (user) {\n      this.fetchData(user.id);\n    }\n  },\n  methods: {\n    async fetchData(id) {\n      try {\n        const res = await getMyHistory(id);\n        this.list = res || [];\n      } catch (e) {\n        console.error(e);\n      }\n    },\n    formatTime(time) {\n      if (!time) return '';\n      return new Date(time).toLocaleString();\n    }\n  }\n};","map":{"version":3,"names":["getMyHistory","getUser","name","data","list","created","user","fetchData","id","methods","res","e","console","error","formatTime","time","Date","toLocaleString"],"sources":["C:\\ThesisProject\\frontend\\src\\views\\student\\MyLeaves.vue"],"sourcesContent":["<template>\r\n  <div class=\"my-leaves-container\">\r\n    <h2>我的申请记录</h2>\r\n    <table class=\"data-table\">\r\n      <thead>\r\n        <tr>\r\n          <th>申请ID</th>\r\n          <th>类型ID</th>\r\n          <th>开始时间</th>\r\n          <th>结束时间</th>\r\n          <th>状态</th>\r\n          <th>当前步骤</th>\r\n          <th>申请时间</th>\r\n        </tr>\r\n      </thead>\r\n      <tbody>\r\n        <tr v-for=\"item in list\" :key=\"item.id\">\r\n          <td>{{ item.id }}</td>\r\n          <td>{{ item.leaveTypeId }}</td>\r\n          <td>{{ formatTime(item.startTime) }}</td>\r\n          <td>{{ formatTime(item.endTime) }}</td>\r\n          <td>\r\n            <span :class=\"'status-' + item.status.toLowerCase()\">{{ item.status }}</span>\r\n          </td>\r\n          <td>{{ item.currentStep }}</td>\r\n          <td>{{ formatTime(item.createdAt) }}</td>\r\n        </tr>\r\n      </tbody>\r\n    </table>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { getMyHistory } from '@/api/leave'\r\nimport { getUser } from '@/utils/auth'\r\n\r\nexport default {\r\n  name: 'MyLeaves',\r\n  data() {\r\n    return {\r\n      list: []\r\n    }\r\n  },\r\n  created() {\r\n    const user = getUser()\r\n    if (user) {\r\n      this.fetchData(user.id)\r\n    }\r\n  },\r\n  methods: {\r\n    async fetchData(id) {\r\n      try {\r\n        const res = await getMyHistory(id)\r\n        this.list = res || []\r\n      } catch (e) {\r\n        console.error(e)\r\n      }\r\n    },\r\n    formatTime(time) {\r\n      if (!time) return ''\r\n      return new Date(time).toLocaleString()\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.my-leaves-container {\r\n  padding: 20px;\r\n}\r\n.data-table {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n  margin-top: 15px;\r\n}\r\n.data-table th, .data-table td {\r\n  border: 1px solid #ddd;\r\n  padding: 10px;\r\n  text-align: left;\r\n}\r\n.status-approved { color: green; font-weight: bold; }\r\n.status-rejected { color: red; font-weight: bold; }\r\n.status-pending { color: orange; }\r\n</style>\r\n"],"mappings":"AAiCA,SAASA,YAAW,QAAS,aAAY;AACzC,SAASC,OAAM,QAAS,cAAa;AAErC,eAAe;EACbC,IAAI,EAAE,UAAU;EAChBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE;IACR;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,MAAMC,IAAG,GAAIL,OAAO,CAAC;IACrB,IAAIK,IAAI,EAAE;MACR,IAAI,CAACC,SAAS,CAACD,IAAI,CAACE,EAAE;IACxB;EACF,CAAC;EACDC,OAAO,EAAE;IACP,MAAMF,SAASA,CAACC,EAAE,EAAE;MAClB,IAAI;QACF,MAAME,GAAE,GAAI,MAAMV,YAAY,CAACQ,EAAE;QACjC,IAAI,CAACJ,IAAG,GAAIM,GAAE,IAAK,EAAC;MACtB,EAAE,OAAOC,CAAC,EAAE;QACVC,OAAO,CAACC,KAAK,CAACF,CAAC;MACjB;IACF,CAAC;IACDG,UAAUA,CAACC,IAAI,EAAE;MACf,IAAI,CAACA,IAAI,EAAE,OAAO,EAAC;MACnB,OAAO,IAAIC,IAAI,CAACD,IAAI,CAAC,CAACE,cAAc,CAAC;IACvC;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}