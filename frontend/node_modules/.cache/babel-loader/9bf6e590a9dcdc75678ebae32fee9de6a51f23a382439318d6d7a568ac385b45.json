{"ast":null,"code":"import { login } from '@/api/auth';\nimport { setUser, setToken } from '@/utils/auth';\nimport { User, Lock } from '@element-plus/icons-vue'; // Icons need to be registered or imported\nimport { ElMessage } from 'element-plus';\nexport default {\n  name: 'Login',\n  components: {\n    // Note: In real setup, icons usually global registered. \n    // Here simplified.\n  },\n  data() {\n    return {\n      form: {\n        username: '',\n        password: ''\n      },\n      loading: false\n    };\n  },\n  methods: {\n    async handleLogin() {\n      if (!this.form.username || !this.form.password) {\n        ElMessage.warning('请输入用户名和密码');\n        return;\n      }\n      this.loading = true;\n      try {\n        const res = await login(this.form);\n        setToken(res.token);\n        setUser(res.user);\n        const user = res.user;\n        ElMessage.success('登录成功');\n        if (user.role === 'TEACHER') {\n          this.$router.push('/teacher/tasks');\n        } else if (user.role === 'ADMIN') {\n          this.$router.push('/admin/dashboard');\n        } else {\n          this.$router.push('/student/apply');\n        }\n      } catch (err) {\n        ElMessage.error(err.response?.data || '登录失败');\n      } finally {\n        this.loading = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["login","setUser","setToken","User","Lock","ElMessage","name","components","data","form","username","password","loading","methods","handleLogin","warning","res","token","user","success","role","$router","push","err","error","response"],"sources":["C:\\ThesisProject\\frontend\\src\\views\\Login.vue"],"sourcesContent":["<template>\n  <div class=\"login-container\">\n    <el-card class=\"login-card\">\n      <template #header>\n        <div class=\"card-header\">\n          <h2>请假管理系统</h2>\n        </div>\n      </template>\n      \n      <el-form :model=\"form\" @submit.prevent=\"handleLogin\" label-width=\"80px\">\n        <el-form-item label=\"用户名\">\n          <el-input v-model=\"form.username\" placeholder=\"请输入学号/工号\" prefix-icon=\"User\" />\n        </el-form-item>\n        \n        <el-form-item label=\"密码\">\n          <el-input \n            v-model=\"form.password\" \n            type=\"password\" \n            placeholder=\"请输入密码\" \n            prefix-icon=\"Lock\" \n            show-password \n          />\n        </el-form-item>\n\n        <el-form-item>\n          <el-button type=\"primary\" :loading=\"loading\" @click=\"handleLogin\" class=\"w-100\">\n            登录\n          </el-button>\n        </el-form-item>\n        \n        <div class=\"links\">\n          <router-link to=\"/register\">\n            <el-link type=\"primary\">没有账号？去注册</el-link>\n          </router-link>\n        </div>\n      </el-form>\n    </el-card>\n  </div>\n</template>\n\n<script>\nimport { login } from '@/api/auth'\nimport { setUser, setToken } from '@/utils/auth'\nimport { User, Lock } from '@element-plus/icons-vue' // Icons need to be registered or imported\nimport { ElMessage } from 'element-plus'\n\nexport default {\n  name: 'Login',\n  components: {\n    // Note: In real setup, icons usually global registered. \n    // Here simplified.\n  },\n  data() {\n    return {\n      form: {\n        username: '',\n        password: ''\n      },\n      loading: false\n    }\n  },\n  methods: {\n    async handleLogin() {\n      if(!this.form.username || !this.form.password) {\n        ElMessage.warning('请输入用户名和密码')\n        return\n      }\n\n      this.loading = true\n      try {\n        const res = await login(this.form)\n        setToken(res.token)\n        setUser(res.user)\n        \n        const user = res.user\n        ElMessage.success('登录成功')\n        \n        if (user.role === 'TEACHER') {\n          this.$router.push('/teacher/tasks')\n        } else if (user.role === 'ADMIN') {\n          this.$router.push('/admin/dashboard')\n        } else {\n          this.$router.push('/student/apply')\n        }\n      } catch (err) {\n        ElMessage.error(err.response?.data || '登录失败')\n      } finally {\n        this.loading = false\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.login-container {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  height: 100vh;\n  background-color: #f0f2f5;\n  background-image: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);\n}\n.login-card {\n  width: 400px;\n}\n.card-header {\n  text-align: center;\n}\n.card-header h2 {\n  margin: 0;\n  color: #303133;\n}\n.w-100 {\n  width: 100%;\n}\n.links {\n  text-align: right;\n  margin-top: 10px;\n}\n</style>\n"],"mappings":"AAyCA,SAASA,KAAI,QAAS,YAAW;AACjC,SAASC,OAAO,EAAEC,QAAO,QAAS,cAAa;AAC/C,SAASC,IAAI,EAAEC,IAAG,QAAS,yBAAwB,EAAE;AACrD,SAASC,SAAQ,QAAS,cAAa;AAEvC,eAAe;EACbC,IAAI,EAAE,OAAO;EACbC,UAAU,EAAE;IACV;IACA;EAAA,CACD;EACDC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE;QACJC,QAAQ,EAAE,EAAE;QACZC,QAAQ,EAAE;MACZ,CAAC;MACDC,OAAO,EAAE;IACX;EACF,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,WAAWA,CAAA,EAAG;MAClB,IAAG,CAAC,IAAI,CAACL,IAAI,CAACC,QAAO,IAAK,CAAC,IAAI,CAACD,IAAI,CAACE,QAAQ,EAAE;QAC7CN,SAAS,CAACU,OAAO,CAAC,WAAW;QAC7B;MACF;MAEA,IAAI,CAACH,OAAM,GAAI,IAAG;MAClB,IAAI;QACF,MAAMI,GAAE,GAAI,MAAMhB,KAAK,CAAC,IAAI,CAACS,IAAI;QACjCP,QAAQ,CAACc,GAAG,CAACC,KAAK;QAClBhB,OAAO,CAACe,GAAG,CAACE,IAAI;QAEhB,MAAMA,IAAG,GAAIF,GAAG,CAACE,IAAG;QACpBb,SAAS,CAACc,OAAO,CAAC,MAAM;QAExB,IAAID,IAAI,CAACE,IAAG,KAAM,SAAS,EAAE;UAC3B,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC,gBAAgB;QACpC,OAAO,IAAIJ,IAAI,CAACE,IAAG,KAAM,OAAO,EAAE;UAChC,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC,kBAAkB;QACtC,OAAO;UACL,IAAI,CAACD,OAAO,CAACC,IAAI,CAAC,gBAAgB;QACpC;MACF,EAAE,OAAOC,GAAG,EAAE;QACZlB,SAAS,CAACmB,KAAK,CAACD,GAAG,CAACE,QAAQ,EAAEjB,IAAG,IAAK,MAAM;MAC9C,UAAU;QACR,IAAI,CAACI,OAAM,GAAI,KAAI;MACrB;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}