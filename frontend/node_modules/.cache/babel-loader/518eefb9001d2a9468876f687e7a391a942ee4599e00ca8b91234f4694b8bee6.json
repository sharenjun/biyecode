{"ast":null,"code":"import { getPendingTasks, submitApprovalAction } from '@/api/approval';\nexport default {\n  name: 'ApprovalTask',\n  data() {\n    return {\n      tasks: [],\n      loading: false,\n      teacherId: 2,\n      // Hardcoded for testing (Teacher ID)\n      showModal: false,\n      currentTask: null,\n      currentAction: '',\n      comment: ''\n    };\n  },\n  created() {\n    this.fetchTasks();\n  },\n  methods: {\n    async fetchTasks() {\n      this.loading = true;\n      try {\n        const res = await getPendingTasks(this.teacherId);\n        this.tasks = res || [];\n      } catch (error) {\n        console.error(error);\n      } finally {\n        this.loading = false;\n      }\n    },\n    formatTime(time) {\n      if (!time) return '';\n      return new Date(time).toLocaleString();\n    },\n    openModal(task, action) {\n      this.currentTask = task;\n      this.currentAction = action;\n      this.comment = '';\n      this.showModal = true;\n    },\n    closeModal() {\n      this.showModal = false;\n      this.currentTask = null;\n    },\n    async confirmAction() {\n      if (!this.currentTask) return;\n      try {\n        await submitApprovalAction({\n          applicationId: this.currentTask.id,\n          approverId: this.teacherId,\n          action: this.currentAction,\n          comment: this.comment\n        });\n        alert('操作成功');\n        this.closeModal();\n        this.fetchTasks(); // Refresh list\n      } catch (error) {\n        alert('操作失败: ' + error.message);\n      }\n    }\n  }\n};","map":{"version":3,"names":["getPendingTasks","submitApprovalAction","name","data","tasks","loading","teacherId","showModal","currentTask","currentAction","comment","created","fetchTasks","methods","res","error","console","formatTime","time","Date","toLocaleString","openModal","task","action","closeModal","confirmAction","applicationId","id","approverId","alert","message"],"sources":["C:\\ThesisProject\\frontend\\src\\views\\teacher\\ApprovalTask.vue"],"sourcesContent":["<template>\r\n  <div class=\"approval-container\">\r\n    <h2>待审批任务</h2>\r\n    \r\n    <div v-if=\"loading\">加载中...</div>\r\n    \r\n    <div v-else-if=\"tasks.length === 0\" class=\"no-tasks\">\r\n      暂无待审批任务\r\n    </div>\r\n\r\n    <table v-else class=\"task-table\">\r\n      <thead>\r\n        <tr>\r\n          <th>申请人ID</th>\r\n          <th>请假类型ID</th>\r\n          <th>时长(小时)</th>\r\n          <th>事由</th>\r\n          <th>提交时间</th>\r\n          <th>操作</th>\r\n        </tr>\r\n      </thead>\r\n      <tbody>\r\n        <tr v-for=\"task in tasks\" :key=\"task.id\">\r\n          <td>{{ task.applicantId }}</td>\r\n          <td>{{ task.leaveTypeId }}</td>\r\n          <td>{{ task.durationHours }}</td>\r\n          <td>{{ task.reason }}</td>\r\n          <td>{{ formatTime(task.createdAt) }}</td>\r\n          <td>\r\n            <button class=\"btn-approve\" @click=\"openModal(task, 'APPROVE')\">通过</button>\r\n            <button class=\"btn-reject\" @click=\"openModal(task, 'REJECT')\">驳回</button>\r\n          </td>\r\n        </tr>\r\n      </tbody>\r\n    </table>\r\n\r\n    <!-- 审批弹窗 -->\r\n    <div v-if=\"showModal\" class=\"modal-overlay\">\r\n      <div class=\"modal\">\r\n        <h3>{{ currentAction === 'APPROVE' ? '批准' : '驳回' }}申请</h3>\r\n        <textarea v-model=\"comment\" placeholder=\"请输入审批意见...\"></textarea>\r\n        <div class=\"modal-actions\">\r\n          <button @click=\"closeModal\">取消</button>\r\n          <button class=\"btn-confirm\" @click=\"confirmAction\">确认</button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { getPendingTasks, submitApprovalAction } from '@/api/approval'\r\n\r\nexport default {\r\n  name: 'ApprovalTask',\r\n  data() {\r\n    return {\r\n      tasks: [],\r\n      loading: false,\r\n      teacherId: 2, // Hardcoded for testing (Teacher ID)\r\n      showModal: false,\r\n      currentTask: null,\r\n      currentAction: '',\r\n      comment: ''\r\n    }\r\n  },\r\n  created() {\r\n    this.fetchTasks()\r\n  },\r\n  methods: {\r\n    async fetchTasks() {\r\n      this.loading = true\r\n      try {\r\n        const res = await getPendingTasks(this.teacherId)\r\n        this.tasks = res || []\r\n      } catch (error) {\r\n        console.error(error)\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    },\r\n    formatTime(time) {\r\n        if (!time) return ''\r\n        return new Date(time).toLocaleString()\r\n    },\r\n    openModal(task, action) {\r\n      this.currentTask = task\r\n      this.currentAction = action\r\n      this.comment = ''\r\n      this.showModal = true\r\n    },\r\n    closeModal() {\r\n      this.showModal = false\r\n      this.currentTask = null\r\n    },\r\n    async confirmAction() {\r\n      if (!this.currentTask) return\r\n\r\n      try {\r\n        await submitApprovalAction({\r\n          applicationId: this.currentTask.id,\r\n          approverId: this.teacherId,\r\n          action: this.currentAction,\r\n          comment: this.comment\r\n        })\r\n        alert('操作成功')\r\n        this.closeModal()\r\n        this.fetchTasks() // Refresh list\r\n      } catch (error) {\r\n        alert('操作失败: ' + error.message)\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.approval-container {\r\n  padding: 20px;\r\n}\r\n.task-table {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n  margin-top: 20px;\r\n}\r\n.task-table th, .task-table td {\r\n  border: 1px solid #ddd;\r\n  padding: 12px;\r\n  text-align: left;\r\n}\r\n.task-table th {\r\n  background-color: #f2f2f2;\r\n}\r\n.btn-approve {\r\n  background-color: #4CAF50;\r\n  color: white;\r\n  margin-right: 5px;\r\n}\r\n.btn-reject {\r\n  background-color: #f44336;\r\n  color: white;\r\n}\r\nbutton {\r\n  border: none;\r\n  padding: 5px 10px;\r\n  cursor: pointer;\r\n  border-radius: 4px;\r\n}\r\n/* Modal Styles */\r\n.modal-overlay {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  background: rgba(0,0,0,0.5);\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n}\r\n.modal {\r\n  background: white;\r\n  padding: 20px;\r\n  border-radius: 8px;\r\n  width: 400px;\r\n}\r\n.modal textarea {\r\n  width: 100%;\r\n  height: 100px;\r\n  margin: 10px 0;\r\n}\r\n.modal-actions {\r\n  display: flex;\r\n  justify-content: flex-end;\r\n  gap: 10px;\r\n}\r\n</style>\r\n"],"mappings":"AAmDA,SAASA,eAAe,EAAEC,oBAAmB,QAAS,gBAAe;AAErE,eAAe;EACbC,IAAI,EAAE,cAAc;EACpBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAE,EAAE;MACTC,OAAO,EAAE,KAAK;MACdC,SAAS,EAAE,CAAC;MAAE;MACdC,SAAS,EAAE,KAAK;MAChBC,WAAW,EAAE,IAAI;MACjBC,aAAa,EAAE,EAAE;MACjBC,OAAO,EAAE;IACX;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,UAAU,CAAC;EAClB,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,UAAUA,CAAA,EAAG;MACjB,IAAI,CAACP,OAAM,GAAI,IAAG;MAClB,IAAI;QACF,MAAMS,GAAE,GAAI,MAAMd,eAAe,CAAC,IAAI,CAACM,SAAS;QAChD,IAAI,CAACF,KAAI,GAAIU,GAAE,IAAK,EAAC;MACvB,EAAE,OAAOC,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAACA,KAAK;MACrB,UAAU;QACR,IAAI,CAACV,OAAM,GAAI,KAAI;MACrB;IACF,CAAC;IACDY,UAAUA,CAACC,IAAI,EAAE;MACb,IAAI,CAACA,IAAI,EAAE,OAAO,EAAC;MACnB,OAAO,IAAIC,IAAI,CAACD,IAAI,CAAC,CAACE,cAAc,CAAC;IACzC,CAAC;IACDC,SAASA,CAACC,IAAI,EAAEC,MAAM,EAAE;MACtB,IAAI,CAACf,WAAU,GAAIc,IAAG;MACtB,IAAI,CAACb,aAAY,GAAIc,MAAK;MAC1B,IAAI,CAACb,OAAM,GAAI,EAAC;MAChB,IAAI,CAACH,SAAQ,GAAI,IAAG;IACtB,CAAC;IACDiB,UAAUA,CAAA,EAAG;MACX,IAAI,CAACjB,SAAQ,GAAI,KAAI;MACrB,IAAI,CAACC,WAAU,GAAI,IAAG;IACxB,CAAC;IACD,MAAMiB,aAAaA,CAAA,EAAG;MACpB,IAAI,CAAC,IAAI,CAACjB,WAAW,EAAE;MAEvB,IAAI;QACF,MAAMP,oBAAoB,CAAC;UACzByB,aAAa,EAAE,IAAI,CAAClB,WAAW,CAACmB,EAAE;UAClCC,UAAU,EAAE,IAAI,CAACtB,SAAS;UAC1BiB,MAAM,EAAE,IAAI,CAACd,aAAa;UAC1BC,OAAO,EAAE,IAAI,CAACA;QAChB,CAAC;QACDmB,KAAK,CAAC,MAAM;QACZ,IAAI,CAACL,UAAU,CAAC;QAChB,IAAI,CAACZ,UAAU,CAAC,GAAE;MACpB,EAAE,OAAOG,KAAK,EAAE;QACdc,KAAK,CAAC,QAAO,GAAId,KAAK,CAACe,OAAO;MAChC;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}