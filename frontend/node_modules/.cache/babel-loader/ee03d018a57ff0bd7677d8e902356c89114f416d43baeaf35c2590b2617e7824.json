{"ast":null,"code":"import { getUser, removeUser } from '@/utils/auth';\nexport default {\n  data() {\n    return {\n      user: null,\n      activeIndex: '/student/apply'\n    };\n  },\n  created() {\n    this.checkUser();\n    this.activeIndex = this.$route.path;\n  },\n  watch: {\n    $route(to) {\n      this.checkUser();\n      this.activeIndex = to.path;\n    }\n  },\n  methods: {\n    checkUser() {\n      this.user = getUser();\n    },\n    logout() {\n      removeUser();\n      this.user = null;\n      this.$router.push('/login');\n    },\n    getRoleName(role) {\n      const map = {\n        'STUDENT': '学生',\n        'TEACHER': '教师',\n        'ADMIN': '管理员'\n      };\n      return map[role] || role;\n    }\n  }\n};","map":{"version":3,"names":["getUser","removeUser","data","user","activeIndex","created","checkUser","$route","path","watch","to","methods","logout","$router","push","getRoleName","role","map"],"sources":["C:\\ThesisProject\\frontend\\src\\App.vue"],"sourcesContent":["<template>\n  <div id=\"app\">\n    <el-menu\n      v-if=\"user\"\n      :default-active=\"activeIndex\"\n      class=\"el-menu-demo\"\n      mode=\"horizontal\"\n      background-color=\"#545c64\"\n      text-color=\"#fff\"\n      active-text-color=\"#ffd04b\"\n      router\n    >\n      <div class=\"logo\">Leave System</div>\n      \n      <!-- Student Links -->\n      <template v-if=\"user.role === 'STUDENT'\">\n        <el-menu-item index=\"/student/apply\">我要请假</el-menu-item>\n        <el-menu-item index=\"/student/history\">申请记录</el-menu-item>\n        <el-menu-item index=\"/student/notifications\">消息通知</el-menu-item>\n      </template>\n\n      <!-- Teacher Links -->\n      <template v-if=\"user.role === 'TEACHER'\">\n        <el-menu-item index=\"/teacher/tasks\">待办审批</el-menu-item>\n        <el-menu-item index=\"/teacher/dashboard\">数据看板</el-menu-item>\n      </template>\n\n      <!-- Admin Links -->\n      <template v-if=\"user.role === 'ADMIN'\">\n        <el-menu-item index=\"/admin/dashboard\">系统监控</el-menu-item>\n      </template>\n\n      <div class=\"flex-grow\" />\n\n      <el-sub-menu index=\"user\">\n        <template #title>欢迎, {{ user.realName }} ({{ getRoleName(user.role) }})</template>\n        <el-menu-item index=\"/profile\">个人中心</el-menu-item>\n        <el-menu-item @click=\"logout\">退出登录</el-menu-item>\n      </el-sub-menu>\n    </el-menu>\n\n    <div class=\"main-content\">\n      <router-view/>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { getUser, removeUser } from '@/utils/auth'\n\nexport default {\n  data() {\n    return {\n      user: null,\n      activeIndex: '/student/apply'\n    }\n  },\n  created() {\n    this.checkUser()\n    this.activeIndex = this.$route.path\n  },\n  watch: {\n    $route(to) {\n      this.checkUser()\n      this.activeIndex = to.path\n    }\n  },\n  methods: {\n    checkUser() {\n      this.user = getUser()\n    },\n    logout() {\n      removeUser()\n      this.user = null\n      this.$router.push('/login')\n    },\n    getRoleName(role) {\n      const map = {\n        'STUDENT': '学生',\n        'TEACHER': '教师',\n        'ADMIN': '管理员'\n      }\n      return map[role] || role\n    }\n  }\n}\n</script>\n\n<style>\nbody {\n  margin: 0;\n  padding: 0;\n  font-family: 'Helvetica Neue', Helvetica, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', '微软雅黑', Arial, sans-serif;\n  background-color: #f5f7fa;\n}\n.logo {\n  color: #fff;\n  font-size: 20px;\n  font-weight: bold;\n  line-height: 60px;\n  padding: 0 20px;\n  cursor: pointer;\n}\n.flex-grow {\n  flex-grow: 1;\n}\n.main-content {\n  padding: 20px;\n  max-width: 1200px;\n  margin: 0 auto;\n}\n</style>\n"],"mappings":"AAgDA,SAASA,OAAO,EAAEC,UAAS,QAAS,cAAa;AAEjD,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE,IAAI;MACVC,WAAW,EAAE;IACf;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,SAAS,CAAC;IACf,IAAI,CAACF,WAAU,GAAI,IAAI,CAACG,MAAM,CAACC,IAAG;EACpC,CAAC;EACDC,KAAK,EAAE;IACLF,MAAMA,CAACG,EAAE,EAAE;MACT,IAAI,CAACJ,SAAS,C