{"ast":null,"code":"import { register } from '@/api/auth';\nexport default {\n  name: 'Register',\n  data() {\n    return {\n      form: {\n        username: '',\n        realName: '',\n        password: '',\n        role: 'STUDENT',\n        departmentId: 1\n      },\n      loading: false,\n      error: ''\n    };\n  },\n  methods: {\n    async handleRegister() {\n      this.loading = true;\n      this.error = '';\n      try {\n        await register(this.form);\n        alert('注册成功，请登录');\n        this.$router.push('/login');\n      } catch (err) {\n        this.error = err.response?.data || '注册失败';\n      } finally {\n        this.loading = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["register","name","data","form","username","realName","password","role","departmentId","loading","error","methods","handleRegister","alert","$router","push","err","response"],"sources":["C:\\ThesisProject\\frontend\\src\\views\\Register.vue"],"sourcesContent":["<template>\r\n  <div class=\"auth-container\">\r\n    <h2>注册</h2>\r\n    <form @submit.prevent=\"handleRegister\">\r\n      <div class=\"form-group\">\r\n        <label>用户名:</label>\r\n        <input type=\"text\" v-model=\"form.username\" required />\r\n      </div>\r\n      <div class=\"form-group\">\r\n        <label>真实姓名:</label>\r\n        <input type=\"text\" v-model=\"form.realName\" required />\r\n      </div>\r\n      <div class=\"form-group\">\r\n        <label>密码:</label>\r\n        <input type=\"password\" v-model=\"form.password\" required />\r\n      </div>\r\n      <div class=\"form-group\">\r\n        <label>角色:</label>\r\n        <select v-model=\"form.role\">\r\n          <option value=\"STUDENT\">学生</option>\r\n          <option value=\"TEACHER\">教师</option>\r\n        </select>\r\n      </div>\r\n\r\n      <div class=\"form-group\" v-if=\"form.role\">\r\n        <label>{{ form.role === 'STUDENT' ? '所在班级' : '管理班级' }}:</label>\r\n        <input type=\"text\" v-model=\"form.className\" :placeholder=\"form.role === 'STUDENT' ? '例如: 2023级1班' : '例如: 2023级1班, 2班'\" required />\r\n      </div>\r\n\r\n      <div class=\"form-group\">\r\n        <label>院系ID (默认为1-计算机系):</label>\r\n        <input type=\"number\" v-model.number=\"form.departmentId\" />\r\n      </div>\r\n      <button type=\"submit\" :disabled=\"loading\">注册</button>\r\n      <div class=\"links\">\r\n        <router-link to=\"/login\">已有账号？去登录</router-link>\r\n      </div>\r\n    </form>\r\n    <div v-if=\"error\" class=\"error\">{{ error }}</div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { register } from '@/api/auth'\r\n\r\nexport default {\r\n  name: 'Register',\r\n  data() {\r\n    return {\r\n      form: {\r\n        username: '',\r\n        realName: '',\r\n        password: '',\r\n        role: 'STUDENT',\r\n        departmentId: 1\r\n      },\r\n      loading: false,\r\n      error: ''\r\n    }\r\n  },\r\n  methods: {\r\n    async handleRegister() {\r\n      this.loading = true\r\n      this.error = ''\r\n      try {\r\n        await register(this.form)\r\n        alert('注册成功，请登录')\r\n        this.$router.push('/login')\r\n      } catch (err) {\r\n        this.error = err.response?.data || '注册失败'\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.auth-container {\r\n  max-width: 400px;\r\n  margin: 50px auto;\r\n  padding: 30px;\r\n  border: 1px solid #eee;\r\n  border-radius: 8px;\r\n  box-shadow: 0 2px 12px 0 rgba(0,0,0,0.1);\r\n}\r\n.form-group {\r\n  margin-bottom: 20px;\r\n}\r\n.form-group label {\r\n  display: block;\r\n  margin-bottom: 5px;\r\n}\r\n.form-group input, .form-group select {\r\n  width: 100%;\r\n  padding: 10px;\r\n  box-sizing: border-box;\r\n}\r\nbutton {\r\n  width: 100%;\r\n  padding: 12px;\r\n  background-color: #67C23A;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n}\r\n.links {\r\n  margin-top: 15px;\r\n  text-align: right;\r\n}\r\n.error {\r\n  color: red;\r\n  margin-top: 10px;\r\n  text-align: center;\r\n}\r\n</style>\r\n"],"mappings":"AA2CA,SAASA,QAAO,QAAS,YAAW;AAEpC,eAAe;EACbC,IAAI,EAAE,UAAU;EAChBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE;QACJC,QAAQ,EAAE,EAAE;QACZC,QAAQ,EAAE,EAAE;QACZC,QAAQ,EAAE,EAAE;QACZC,IAAI,EAAE,SAAS;QACfC,YAAY,EAAE;MAChB,CAAC;MACDC,OAAO,EAAE,KAAK;MACdC,KAAK,EAAE;IACT;EACF,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,cAAcA,CAAA,EAAG;MACrB,IAAI,CAACH,OAAM,GAAI,IAAG;MAClB,IAAI,CAACC,KAAI,GAAI,EAAC;MACd,IAAI;QACF,MAAMV,QAAQ,CAAC,IAAI,CAACG,IAAI;QACxBU,KAAK,CAAC,UAAU;QAChB,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC,QAAQ;MAC5B,EAAE,OAAOC,GAAG,EAAE;QACZ,IAAI,CAACN,KAAI,GAAIM,GAAG,CAACC,QAAQ,EAAEf,IAAG,IAAK,MAAK;MAC1C,UAAU;QACR,IAAI,CAACO,OAAM,GAAI,KAAI;MACrB;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}